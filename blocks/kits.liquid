<p class="text-custom-blue text-[12px]">QUANTIDADE:</p>

<div class="wrapper-kits !text-[#4D4D4D] leading-tight">
  {% if block.settings.bloco_01_qtd_texto != blank %}
    <label class="kit bloco-01 flex items-center p-[16px] border border-[#AEB6B3] w-full rounded-[8px] relative mt-[8px] {% if block.settings.bloco_01_tag != blank %}mt-[22px]{% endif %} peer-checked:border-custom-blue">
      <input
        type="radio"
        name="kit"
        value="{{ block.settings.bloco_01_qtd }}"
        class="kit-input w-[20px] h-[20px] accent-custom-blue peer"
      >
      {% if block.settings.bloco_01_tag != blank %}
        <span class="kit-tag absolute top-[-15px] px-[5px] right-[10px] bg-custom-blue text-[#fff] font-[700] text-[12px] rounded-tl-[4px] rounded-tr-[4px]">
          {{- block.settings.bloco_01_tag -}}
        </span>
      {% endif %}

      <div class="kit-box flex w-full justify-between">
        <div class="unidades-economize flex flex-col !gap-0 justify-center">
          <p class="kit-qtd text-[16px]">{{ block.settings.bloco_01_qtd_texto }}</p>
          {% if block.settings.bloco_01_economize != blank %}
            <span class="kit-economize text-[13px]">{{ block.settings.bloco_01_economize }}</span>
          {% endif %}
        </div>

        <p class="kit-preco flex flex-col items-end !gap-0">
          <span class="valor-kit" data-qtd="{{ block.settings.bloco_01_qtd }}"></span>
          {% if product.compare_at_price_max > product.price %}
            <span class="valor-comparativo line-through text-[13px] opacity-70 text-[14px] text-[#AEB6B3]">
              {{ product.compare_at_price_max | money }}
            </span>
          {% endif %}
        </p>
      </div>
    </label>
  {% endif %}

