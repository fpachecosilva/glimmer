{%- liquid
  assign free_shipping_pure = settings.free_shipping_value | times: 100
  assign free_shipping_threshold = free_shipping_pure | divided_by: 100.0
  assign cart_total = cart.total_price | divided_by: 100.0
  assign amount_remaining = free_shipping_threshold | minus: cart_total
  assign progress_percentage = cart_total | divided_by: free_shipping_threshold | times: 100
  if progress_percentage > 100
    assign progress_percentage = 100
  endif
-%}

<style>
  .free-shipping-bar {
    text-align: center;
    padding: 20px 16px;
    margin: 24px;
    margin-top: 0;
    border-radius: 8px;
    max-width: 100%;
    background: #fde7df;
  }

  .free-shipping-bar div:empty {
    display: block !important;
  }

  .free-shipping-bar__message {
    font-size: 12px;
    margin-top: 4px;
  }

  .free-shipping-bar__message.incomplete,
  .free-shipping-bar__message.complete {
    text-align: center !important;
  }

  .free-shipping-bar__progress-container {
    background-color: #fff;
    border-radius: 100px;
    overflow: visible;
    height: 12px;
    position: relative;
  }

  .free-shipping-bar__progress {
    height: 100%;
    transition: width 0.4s ease-in-out;
  }

  .free-shipping-bar__progress-incomplete {
    background-color: #f697b4;
    border-radius: 100px;
  }

  .free-shipping-bar__progress-complete {
    background-color: var(--custom-blue);
  }

  .free-shipping-bar__message.incomplete,
  .free-shipping-bar__message.complete {
    color: var(--custom-blue);
    font-size: 14px;
    text-align: left;
  }

  .free-shipping-bar__cursor {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 25px;
    height: 25px;
    background-size: contain;
    background-repeat: no-repeat;
    z-index: 10;
  }

  .free-shipping-bar__cursor-incomplete {
    background-image: url('data:image/svg+xml;base64,');
  }

  .free-shipping-bar__cursor-complete {
    background-image: url('data:image/svg+xml;base64,');
  }
</style>

<div class="free-shipping-bar">
  <div class="free-shipping-bar__progress-container">
    <div
      class="free-shipping-bar__progress {% if amount_remaining <= 0 %}free-shipping-bar__progress-complete{% else %}free-shipping-bar__progress-incomplete{% endif %}"
      style="width: {{ progress_percentage }}%;"
    ></div>
  </div>
  <div class="free-shipping-bar__message {% if amount_remaining <= 0 %}complete{% else %}incomplete{% endif %}">
    {%- if amount_remaining <= 0 -%}
      Parabéns, você ganhou Frete Grátis!
    {%- else -%}
      Faltam <span class="text-[#F697B4]">R$ {{ amount_remaining | replace: '.', ',' | append: '0' }}</span> para o
      frete grátis
    {%- endif -%}
  </div>
</div>
